// Training instance helper functions
function getEntityTypeLabel(entityType: string): string {
  switch (entityType) {
    case 'region':
    case 'regional': return 'Regional Demand';
    case 'zone':
    case 'zonal': return 'Zonal Demand';
    case 'wind': return 'Wind CFAC';
    case 'solar': return 'Solar CFAC';
    case 'cfac': return 'Capacity Factor';
    case 'calibration': return 'CFAC Calibration';
    default: return entityType;
  }
}

function formatInstanceDate(dateStr: string): string {
  const date = new Date(dateStr);
  return date.toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit'
  });
}

function formatInstanceDateShort(dateStr: string): string {
  const date = new Date(dateStr);
  return date.toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric'
  });
}

