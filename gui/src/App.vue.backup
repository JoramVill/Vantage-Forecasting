function getMapeClass(mape: number | undefined): string {
  if (!mape) return '';
  if (mape < 10) return 'mape-excellent';
  if (mape < 20) return 'mape-good';
  if (mape < 30) return 'mape-fair';
  return 'mape-poor';
}

// Phase 1B: MAPE bar helpers for Evaluation tab
function getMapeBarWidth(mape: number | null): string {
  if (mape === null) return '0%';
  const width = Math.min(100, (mape / 10) * 100);
  return `${width}%`;
}

function getMapeBarColor(mape: number | null): string {
  if (mape === null) return 'var(--text-muted)';
  if (mape < 2) return 'var(--success-color, #10b981)';
  if (mape < 4) return 'var(--warning-color, #f59e0b)';
  return 'var(--error-color, #ef4444)';
}

