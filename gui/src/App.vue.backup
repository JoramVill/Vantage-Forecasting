        { code: '09NWMIN', name: 'Northwest Mindanao', parentRegion: 'mindanao' },
        { code: '10LANAO', name: 'Lanao', parentRegion: 'mindanao' },
        { code: '11NCMIN', name: 'North Central Mindanao', parentRegion: 'mindanao' },
