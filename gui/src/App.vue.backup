async function exportModel(id: string) {
  try {
    const result = await window.electronAPI.exportModel(id);
    if (result.success) {
      alert(`Model exported successfully to:\n${result.path}`);
    } else {
      if (result.error !== 'Export cancelled') {
        alert(`Export failed: ${result.error}`);
      }
    }
  } catch (error: any) {
    console.error('Failed to export model:', error);
    alert(`Export failed: ${error.message}`);
  }
}

async function importModel() {
  try {
    modelsLoading.value = true;
    const result = await window.electronAPI.importModel();
    if (result.success) {
      alert(`Model imported successfully!\nNew ID: ${result.id}`);
      await loadModels();
    } else {
      if (result.error !== 'Import cancelled') {
        alert(`Import failed: ${result.error}`);
      }
    }
  } catch (error: any) {
    console.error('Failed to import model:', error);
    alert(`Import failed: ${error.message}`);
  } finally {
    modelsLoading.value = false;
  }
}

