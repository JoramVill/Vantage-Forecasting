function formatModelType(type: string | undefined): string {
  if (!type) return 'Unknown';
  const typeMap: Record<string, string> = {
    'hybrid': 'Hybrid',
    'xgboost': 'XGBoost',
    'regression': 'Regression',
    '4tier': '4-Tier',
    'mrec': 'MREC',
    'physics': 'Physics',
    'scaling': 'Scaling'
  };
  return typeMap[type.toLowerCase()] || type;
}

